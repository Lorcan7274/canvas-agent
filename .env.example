# Copy to .env and run with: node --env-file=.env apps/server/dist/main.js
PORT=8787
BASE_URL=http://localhost:8787
SECRET_KEY=change-me-to-a-long-random-string
DB_PATH=./data/canvas-agent.sqlite

# Sign in with Google + Google Calendar (redirect URI: $BASE_URL/oauth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_MODE=google

# Claude task cards for new assignments (one call per assignment version)
# ANTHROPIC_API_KEY=
# USE_LLM=true

# SYNC_INTERVAL_MINUTES=30
# CANVAS_HOSTS=canvas.school.edu,school.instructure.com
