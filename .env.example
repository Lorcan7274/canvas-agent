# Copy to .env, then: pnpm build && node --env-file=.env apps/server/dist/main.js
# Production (NODE_ENV=production or an https BASE_URL) needs SECRET_KEY and Google sign-in.
PORT=8787
BASE_URL=http://localhost:8787
# 32+ random characters, e.g. `openssl rand -base64 48`. Blank uses a dev key, refused in production.
SECRET_KEY=
DB_PATH=./data/canvas-agent.sqlite

# Sign in with Google + Google Calendar (redirect URI: $BASE_URL/oauth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_MODE=google
# Dev login in production, for a private test deployment only:
# ALLOW_DEV_LOGIN=1

# Claude task cards for new assignments (one call per assignment version)
# ANTHROPIC_API_KEY=
# USE_LLM=true

# Local development against `pnpm stub` only; refused in production:
# EGRESS_ALLOW_LOOPBACK=1
# SYNC_INTERVAL_MINUTES=30
# CANVAS_HOSTS=canvas.school.edu,school.instructure.com
