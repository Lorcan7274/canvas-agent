{
  "name": "canvas-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Canvas assignments, time estimates and study-block planning for AI assistants, over MCP",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm --filter @canvas-agent/core run build && pnpm run typecheck && pnpm run test",
    "dev": "pnpm --filter @canvas-agent/server run dev",
    "stub": "pnpm --filter @canvas-agent/stub-canvas run start"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
